DOMAIN=draw.example.com
BETTER_AUTH_URL=https://draw.example.com
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
POSTGRES_PASSWORD=replace-me
POSTGRES_USER=pv
POSTGRES_DB=performancevideo

# Initial password for the stevenmarr admin account. Read only at boot.
# If unset, the seed skips and does not create or change that user.
# After the account exists, changing this value does not rotate the password.
DESIGN_ADMIN_PASSWORD=
# Optional inbox for that account. Defaults to stevenmarr@performance-video.local.
DESIGN_ADMIN_EMAIL=

# Comma-separated emails that are promoted to admin on their next visit.
ADMIN_EMAILS=

# SMTP. When unset, password-reset mail is written to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Live-preview OAuth client. Leave empty unless this process is a Grok preview.
GROK_PREVIEW_CLIENT_SECRET=
