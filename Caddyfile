www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri}
}

{$DOMAIN} {
	@bare path /library /library/* /draw /draw/* /company /company/* /login /login/* /admin /admin/*
	redir @bare /diagram{uri}
	@home path /
	handle @home {
		root * /srv/site
		rewrite * /index.html
		file_server
	}
	handle {
		reverse_proxy app:8080
	}
}
